    {
      "parameters": {
        "jsCode": "const text = $('Telegram Trigger').first().json.message.text || '';\nlet sendTime = '';\nlet messageText = text;\n\nif (text.includes('|')) {\n    const parts = text.split('|');\n    const rawTime = parts[0].trim();\n    messageText = parts.slice(1).join('|').trim(); \n\n    if (rawTime.length >= 16) {\n        const datePart = rawTime.substring(0, 10);\n        const timePart = rawTime.substring(11, 16);\n        sendTime = `${datePart}T${timePart}:00`;\n    } else {\n        sendTime = rawTime;\n    }\n}\n\nreturn {\n    json: {\n        ...$input.item.json,\n        sendTime: sendTime,\n        messageText: messageText\n    }\n};\n"
      },
